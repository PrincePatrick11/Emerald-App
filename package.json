    "check:sync": "node scripts/sync-check.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "check:blocks": "node scripts/check-blocks.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:english": "node scripts/check-english.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "agents:link": "node scripts/link-agents.mjs",
    "mcp:register": "node scripts/register-mcp.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "node scripts/make-fonts-css.mjs",
    "preview": "vite preview --configLoader runner",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json"
  },
