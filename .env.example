# Emerald — Environment Variables (Template)
# Kopiere diese Datei: cp .env.example .env
# Trage deine Werte in .env ein — .env wird NICHT committed.

# ── GitHub Integration ────────────────────────────────────────────────────────
# Für Versionierung / Backup via GitHub API
# Erstellen unter: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=your_github_personal_access_token_here
VITE_GITHUB_REPO=emerald
VITE_GITHUB_OWNER=your_github_username_here

# ── App Config ────────────────────────────────────────────────────────────────
# Umgebung: development | production
VITE_APP_ENV=development
